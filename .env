# --- Conexión por variables sueltas (fallback, no se usa si USERS_DB_URL está presente)
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=192.168.7.16
DB_DATABASE=Santiago
DB_USER=SACE
DB_PASSWORD=sace
DB_TRUST_CERT=yes
DB_AUTH=sql

# --- Flask
FLASK_SECRET_KEY=pon_una_clave_larga_y_secreta

# --- URLs completas que SÍ usará la app
USERS_DB_URL=mssql+pyodbc://SACE:sace@192.168.7.16:1433/Santiago?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
RIMA_DB_URL=mssql+pyodbc://SACE:sace@192.168.7.16:1433/RIMA?driver=ODBC+Driver+17+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
